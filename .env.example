# ─────────────────────────────────────────────────────────────────────────────
# Integrated Work Platform — 환경변수 템플릿
# ─────────────────────────────────────────────────────────────────────────────
# 이 파일은 템플릿입니다.
#   1) 같은 폴더에 ".env" 라는 이름으로 복사
#   2) 아래 값들을 실제 키로 채워 넣으세요
#   3) ".env" 는 .gitignore 에 등록되어 있어 저장소에 커밋되지 않습니다
#
# HF Spaces 배포 환경에서는 .env 대신
#   Settings → Repository secrets 에 동일한 키를 등록하세요.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (기본 LLM: gpt-5-mini) ────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── OpenRouter (폴백 모델용) ─────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── 금융감독원 Open API (규제 동향 패널) ─────────────────────────────────────
# 없으면 FSS 수집이 자동으로 비활성화됩니다.
FSS_API_KEY=

# ── 네이버 뉴스 검색 API (규제 동향 패널 - 기관별 모니터링 및 뉴스 검색) ──────
# https://developers.naver.com/apps/#/register → 검색 API 신청
# 미설정 시 BIGKinds 또는 연합뉴스 RSS로 자동 폴백합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# ── NiceGUI 사용자 세션 저장 키 (운영 환경 권장) ────────────────────────────
# 미지정 시 임시 키 자동 생성 (서버 재시작 시 사용자 이니셜 초기화됨).
NICEGUI_STORAGE_SECRET=
